{
  "id": "com.hoymiles.hione",
  "version": "2.0.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#61BA1A",
  "name": {
    "en": "Hoymiles HiOne",
    "nl": "Hoymiles HiOne"
  },
  "description": {
    "en": "Monitor and control your Hoymiles HiOne battery system via Cloud, Modbus TCP and Protobuf.",
    "nl": "Monitor en beheer je Hoymiles HiOne batterijsysteem via Cloud, Modbus TCP en Protobuf."
  },
  "tags": {
    "en": [
      "hoymiles",
      "hione",
      "solar",
      "battery",
      "bess",
      "energy",
      "smiles",
      "inverter",
      "modbus"
    ],
    "nl": [
      "hoymiles",
      "hione",
      "zonnepanelen",
      "batterij",
      "energie",
      "omvormer",
      "modbus"
    ]
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "api": {
    "testLogin": {
      "method": "POST",
      "path": "/login"
    },
    "saveLogin": {
      "method": "POST",
      "path": "/settings/save-login"
    },
    "logout": {
      "method": "POST",
      "path": "/logout"
    },
    "getSettings": {
      "method": "GET",
      "path": "/settings"
    },
    "saveDiagSettings": {
      "method": "POST",
      "path": "/settings/diagnostics"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "startDiagnostics": {
      "method": "POST",
      "path": "/diagnostics/start"
    },
    "stopDiagnostics": {
      "method": "POST",
      "path": "/diagnostics/stop"
    },
    "clearDiagnostics": {
      "method": "POST",
      "path": "/diagnostics/clear"
    },
    "exportDiagnostics": {
      "method": "GET",
      "path": "/diagnostics/export"
    },
    "getDiagnosticsReport": {
      "method": "GET",
      "path": "/diagnostics/report"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Robert Coemans",
    "email": "r.coemans@hotmail.com"
  },
  "homepage": "https://github.com/rcoemans/com.hoymiles.hione",
  "support": "https://github.com/rcoemans/com.hoymiles.hione/issues",
  "source": "https://github.com/rcoemans/com.hoymiles.hione",
  "bugs": {
    "url": "https://github.com/rcoemans/com.hoymiles.hione/issues"
  }
}