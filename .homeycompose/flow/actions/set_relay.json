{
  "id": "set_relay",
  "title": {
    "en": "Set relay state",
    "nl": "Stel relaisstatus in"
  },
  "titleFormatted": {
    "en": "Turn relay [[state]]",
    "nl": "Zet relais [[state]]"
  },
  "hint": {
    "en": "Enable or disable the dry contact relay output.",
    "nl": "Schakel de droogcontact relaisuitgang in of uit."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=hione"
    },
    {
      "name": "state",
      "type": "dropdown",
      "title": { "en": "State", "nl": "Status" },
      "values": [
        { "id": "on", "label": { "en": "Enabled", "nl": "Ingeschakeld" } },
        { "id": "off", "label": { "en": "Disabled", "nl": "Uitgeschakeld" } }
      ]
    }
  ]
}
