{
  "id": "set_inverter_state",
  "title": {
    "en": "Set inverter state",
    "nl": "Stel omvormerstatus in"
  },
  "titleFormatted": {
    "en": "Turn inverter [[state]]",
    "nl": "Zet omvormer [[state]]"
  },
  "hint": {
    "en": "Turn the inverter on or off.",
    "nl": "Zet de omvormer aan of uit."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=hione"
    },
    {
      "name": "state",
      "type": "dropdown",
      "title": { "en": "State", "nl": "Status" },
      "values": [
        { "id": "on", "label": { "en": "On", "nl": "Aan" } },
        { "id": "off", "label": { "en": "Off", "nl": "Uit" } }
      ]
    }
  ]
}
