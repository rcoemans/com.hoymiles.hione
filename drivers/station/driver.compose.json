{
  "name": { "en": "HiOne Station", "nl": "HiOne Station" },
  "class": "battery",
  "capabilities": [
    "measure_power",
    "hoymiles_battery_flow",
    "measure_battery",
    "meter_power.charged",
    "meter_power.discharged",
    "hoymiles_pv_power",
    "hoymiles_grid_power",
    "hoymiles_load_power",
    "hoymiles_battery_mode",
    "hoymiles_reserve_soc",
    "hoymiles_max_soc",
    "hoymiles_max_charge_power",
    "hoymiles_max_discharge_power",
    "hoymiles_grid_limit",
    "hoymiles_daily_energy",
    "hoymiles_monthly_energy",
    "hoymiles_yearly_energy",
    "hoymiles_total_energy",
    "hoymiles_co2_reduction",
    "hoymiles_profit_today",
    "hoymiles_profit_total",
    "hoymiles_battery_charge_power",
    "hoymiles_battery_discharge_power",
    "hoymiles_grid_import_power",
    "hoymiles_grid_export_power",
    "hoymiles_battery_state",
    "hoymiles_grid_state",
    "hoymiles_self_powered_pct",
    "hoymiles_power_balance",
    "hoymiles_battery_runtime",
    "hoymiles_time_to_full",
    "hoymiles_system_state",
    "hoymiles_connection_source",
    "hoymiles_gateway_online",
    "hoymiles_last_update",
    "hoymiles_fault_code",
    "hoymiles_fault_explanation",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": { "en": "Battery Power", "nl": "Accuvermogen" }
    },
    "measure_battery": {
      "title": { "en": "Battery SoC", "nl": "Accu laadniveau" }
    },
    "meter_power.charged": {
      "title": { "en": "Energy Charged", "nl": "Energie geladen" },
      "insights": true,
      "decimals": 2
    },
    "meter_power.discharged": {
      "title": { "en": "Energy Discharged", "nl": "Energie ontladen" },
      "insights": true,
      "decimals": 2
    }
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "images": {
    "small": "/drivers/station/assets/icon.svg",
    "large": "/drivers/station/assets/icon.svg"
  },
  "pair": [
    { "id": "login_credentials" },
    { "id": "select_station" },
    { "id": "configure_local" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ],
  "settings": [
    {
      "type": "group",
      "label": { "en": "Connection", "nl": "Verbinding" },
      "children": [
        {
          "id": "connection_mode",
          "type": "dropdown",
          "label": { "en": "Connection mode", "nl": "Verbindingsmodus" },
          "hint": { "en": "Cloud Only: S-Miles Cloud API. Hybrid: Cloud primary, Local LAN fallback. Local Only: LAN only.", "nl": "Alleen Cloud: S-Miles Cloud API. Hybride: Cloud primair, lokaal LAN als fallback. Alleen lokaal: alleen LAN." },
          "value": "cloud",
          "values": [
            { "id": "cloud",  "label": { "en": "Cloud Only",         "nl": "Alleen Cloud" } },
            { "id": "hybrid", "label": { "en": "Hybrid (Cloud + Local)", "nl": "Hybride (Cloud + Lokaal)" } },
            { "id": "local",  "label": { "en": "Local Only",         "nl": "Alleen Lokaal" } }
          ]
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": { "en": "Poll interval (seconds)", "nl": "Poll-interval (seconden)" },
          "hint": { "en": "How often to fetch data (30–300 seconds). Default: 60.", "nl": "Hoe vaak data ophalen (30–300 seconden). Standaard: 60." },
          "value": 60,
          "min": 30,
          "max": 300
        }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Local (LAN)", "nl": "Lokaal (LAN)" },
      "children": [
        {
          "id": "gateway_ip",
          "type": "text",
          "label": { "en": "Gateway/DTS IP Address", "nl": "Gateway/DTS IP-adres" },
          "hint": { "en": "Local LAN IP of the DTS stick or HiBox gateway (e.g. 192.168.1.100).", "nl": "Lokaal LAN IP-adres van de DTS stick of HiBox gateway (bijv. 192.168.1.100)." },
          "value": ""
        },
        {
          "id": "dtu_sn",
          "type": "text",
          "label": { "en": "DTU Serial Number", "nl": "DTU Serienummer" },
          "hint": { "en": "Serial number of your DTU gateway (e.g. 112700000001). Found on the device label. Required for Protobuf protocol.", "nl": "Serienummer van de DTU gateway (bijv. 112700000001). Te vinden op het apparaatlabel. Vereist voor Protobuf-protocol." },
          "value": ""
        },
        {
          "id": "protobuf_port",
          "type": "number",
          "label": { "en": "Protobuf Port", "nl": "Protobuf Poort" },
          "hint": { "en": "TCP port for Hoymiles binary protocol. Default: 10081.", "nl": "TCP-poort voor Hoymiles binair protocol. Standaard: 10081." },
          "value": 10081,
          "min": 1,
          "max": 65535
        },
        {
          "id": "modbus_port",
          "type": "number",
          "label": { "en": "Modbus Port", "nl": "Modbus Poort" },
          "hint": { "en": "TCP port for Modbus communication. Default: 502.", "nl": "TCP-poort voor Modbus-communicatie. Standaard: 502." },
          "value": 502,
          "min": 1,
          "max": 65535
        },
        {
          "id": "modbus_unit_id",
          "type": "number",
          "label": { "en": "Modbus Unit-ID", "nl": "Modbus Unit-ID" },
          "hint": { "en": "Modbus slave address. Default: 1. Only change if you have multiple Modbus devices on the same bus.", "nl": "Modbus slave-adres. Standaard: 1. Alleen wijzigen als je meerdere Modbus-apparaten op dezelfde bus hebt." },
          "value": 1,
          "min": 1,
          "max": 247
        }
      ]
    },
    {
      "type": "group",
      "label": { "en": "Cloud", "nl": "Cloud" },
      "children": [
        {
          "id": "cloud_api_url",
          "type": "text",
          "label": { "en": "Cloud API URL", "nl": "Cloud API URL" },
          "hint": { "en": "Base URL of the S-Miles Cloud API. The app auto-selects the right endpoint during login. Default: https://neapi.hoymiles.com", "nl": "Basis-URL van de S-Miles Cloud API. De app selecteert automatisch het juiste endpoint bij het inloggen. Standaard: https://neapi.hoymiles.com" },
          "value": "https://neapi.hoymiles.com"
        }
      ]
    },
    {
      "type": "group",
      "label": { "en": "System info", "nl": "Systeeminfo" },
      "children": [
        {
          "id": "system_info",
          "type": "textarea",
          "label": { "en": "Device information", "nl": "Apparaatinformatie" },
          "value": "-"
        },
        {
          "id": "connected_devices",
          "type": "textarea",
          "label": { "en": "Connected devices", "nl": "Gekoppelde apparaten" },
          "value": "-"
        }
      ]
    }
  ]
}
