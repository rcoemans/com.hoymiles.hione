{
  "name": {
    "en": "HiOne Station",
    "nl": "HiOne Station"
  },
  "class": "solarpanel",
  "capabilities": [
    "measure_battery",
    "measure_power",
    "meter_power",
    "hione_pv_power",
    "hione_battery_power",
    "hione_grid_power",
    "hione_load_power",
    "hione_battery_mode",
    "hione_daily_energy",
    "hione_total_energy",
    "hione_battery_charge_power",
    "hione_battery_discharge_power",
    "hione_grid_import_power",
    "hione_grid_export_power",
    "hione_battery_state",
    "hione_grid_state",
    "alarm_generic",
    "hione_self_powered_pct",
    "hione_battery_runtime_hours",
    "hione_time_to_full_hours",
    "hione_power_balance",
    "hione_energy_state",
    "hione_system_state",
    "hione_connection_source",
    "hione_gateway_online",
    "hione_last_update"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "PV Power",
        "nl": "PV-vermogen"
      }
    },
    "measure_battery": {
      "title": {
        "en": "Battery State of Charge",
        "nl": "Batterij laadniveau"
      }
    },
    "meter_power": {
      "title": {
        "en": "Total Energy Generated",
        "nl": "Totale energie opgewekt"
      }
    }
  },
  "energy": {
    "cumulative": true,
    "batteries": [
      "INTERNAL"
    ]
  },
  "images": {
    "small": "/drivers/hione/assets/images/small.png",
    "large": "/drivers/hione/assets/images/large.png",
    "xlarge": "/drivers/hione/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "choose_connection"
    },
    {
      "id": "gateway_ip"
    },
    {
      "id": "login_credentials"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "connection_mode",
      "type": "dropdown",
      "label": {
        "en": "Connection mode",
        "nl": "Verbindingsmodus"
      },
      "hint": {
        "en": "How the device connects: Local only (LAN), Hybrid (local + cloud fallback), or Cloud only.",
        "nl": "Hoe het apparaat verbindt: alleen Lokaal (LAN), Hybride (lokaal + cloud fallback), of alleen Cloud."
      },
      "value": "both",
      "values": [
        { "id": "local", "label": { "en": "Local (LAN)", "nl": "Lokaal (LAN)" } },
        { "id": "both", "label": { "en": "Hybrid (local + cloud)", "nl": "Hybride (lokaal + cloud)" } },
        { "id": "cloud", "label": { "en": "Cloud only", "nl": "Alleen Cloud" } }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "S-Miles Cloud account",
        "nl": "S-Miles Cloud account"
      },
      "children": [
        {
          "id": "cloud_username",
          "type": "text",
          "label": {
            "en": "Email",
            "nl": "E-mail"
          },
          "hint": {
            "en": "S-Miles Cloud login email. Set during pairing, editable here.",
            "nl": "S-Miles Cloud inlog e-mail. Ingesteld tijdens koppeling, hier bewerkbaar."
          },
          "value": ""
        },
        {
          "id": "cloud_password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord"
          },
          "hint": {
            "en": "S-Miles Cloud password. Stored securely on your Homey.",
            "nl": "S-Miles Cloud wachtwoord. Veilig opgeslagen op je Homey."
          },
          "value": ""
        }
      ]
    },
    {
      "id": "gateway_ip",
      "type": "text",
      "label": {
        "en": "Gateway IP address",
        "nl": "Gateway IP-adres"
      },
      "hint": {
        "en": "Local LAN IP of the HiBox gateway for local access (e.g. 192.168.1.100). Leave empty to use cloud only.",
        "nl": "Lokaal LAN IP-adres van de HiBox gateway voor lokale toegang (bijv. 192.168.1.100). Leeg laten voor cloud only."
      },
      "value": ""
    },
    {
      "id": "gateway_port",
      "type": "number",
      "label": {
        "en": "Gateway port",
        "nl": "Gateway poort"
      },
      "hint": {
        "en": "TCP port of the HiBox gateway (default: 10081).",
        "nl": "TCP-poort van de HiBox gateway (standaard: 10081)."
      },
      "value": 10081,
      "min": 1,
      "max": 65535
    },
    {
      "id": "cloud_api_url",
      "type": "text",
      "label": {
        "en": "Cloud API URL",
        "nl": "Cloud API URL"
      },
      "hint": {
        "en": "Base URL of the S-Miles Cloud API (default: https://neapi.hoymiles.com). Only change this if Hoymiles migrates to a different endpoint.",
        "nl": "Basis-URL van de S-Miles Cloud API (standaard: https://neapi.hoymiles.com). Wijzig dit alleen als Hoymiles naar een ander endpoint migreert."
      },
      "value": "https://neapi.hoymiles.com"
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": {
        "en": "Poll interval (seconds)",
        "nl": "Poll-interval (seconden)"
      },
      "hint": {
        "en": "How often to fetch data (30-300 seconds). Default: 60.",
        "nl": "Hoe vaak data ophalen (30-300 seconden). Standaard: 60."
      },
      "value": 60,
      "min": 30,
      "max": 300
    },
    {
      "type": "group",
      "label": {
        "en": "DTU info",
        "nl": "DTU info"
      },
      "children": [
        {
          "id": "dtu_serial",
          "type": "label",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer"
          },
          "value": "-"
        },
        {
          "id": "dtu_firmware",
          "type": "label",
          "label": {
            "en": "Firmware version",
            "nl": "Firmwareversie"
          },
          "value": "-"
        },
        {
          "id": "dtu_hardware",
          "type": "label",
          "label": {
            "en": "Hardware version",
            "nl": "Hardwareversie"
          },
          "value": "-"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Inverter info",
        "nl": "Omvormer info"
      },
      "children": [
        {
          "id": "inverter_serial",
          "type": "label",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer"
          },
          "value": "-"
        },
        {
          "id": "inverter_model",
          "type": "label",
          "label": {
            "en": "Model",
            "nl": "Model"
          },
          "value": "-"
        },
        {
          "id": "inverter_firmware",
          "type": "label",
          "label": {
            "en": "Firmware version",
            "nl": "Firmwareversie"
          },
          "value": "-"
        },
        {
          "id": "inverter_hardware",
          "type": "label",
          "label": {
            "en": "Hardware version",
            "nl": "Hardwareversie"
          },
          "value": "-"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Gateway info (HiBox)",
        "nl": "Gateway info (HiBox)"
      },
      "children": [
        {
          "id": "gateway_serial",
          "type": "label",
          "label": {
            "en": "Serial number",
            "nl": "Serienummer"
          },
          "value": "-"
        },
        {
          "id": "gateway_model",
          "type": "label",
          "label": {
            "en": "Model",
            "nl": "Model"
          },
          "value": "-"
        },
        {
          "id": "gateway_firmware",
          "type": "label",
          "label": {
            "en": "Firmware version",
            "nl": "Firmwareversie"
          },
          "value": "-"
        },
        {
          "id": "gateway_hardware",
          "type": "label",
          "label": {
            "en": "Hardware version",
            "nl": "Hardwareversie"
          },
          "value": "-"
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Battery info",
        "nl": "Batterij info"
      },
      "children": [
        {
          "id": "battery_model",
          "type": "label",
          "label": {
            "en": "Model",
            "nl": "Model"
          },
          "value": "-"
        },
        {
          "id": "battery_count",
          "type": "label",
